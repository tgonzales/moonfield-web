# Shopify — Storefront API (server-only; never exposed to the browser)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2025-01
SHOPIFY_STOREFRONT_API_TOKEN=

# Shopify — Admin API (server-only; used later for webhooks/fulfillment sync)
SHOPIFY_ADMIN_API_TOKEN=

# Shopify — webhook signature verification (Admin > Settings > Notifications > Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# Cloudflare R2 — private bucket for Digital Artifact media (audio, video,
# story/credits/lyrics, visuals). Written only by scripts/*.ts, read via
# short-lived signed URLs (src/lib/cloudflare/r2.ts). Never used for
# product photos — those stay on the Shopify CDN.
CLOUDFLARE_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=moonfield-artifacts
R2_SIGNED_URL_TTL_SECONDS=3600

# Cloudflare R2 — public bucket for openly-streamable content (track preview
# player, see src/components/store/track-player.tsx). Written by
# scripts/upload-release-asset.ts --public.
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=

# Cloudflare account-wide API token — not used by any code yet.
CLOUDFLARE_AUTH_TOKEN=

# Postgres (Neon, via Vercel Marketplace) — Drizzle ORM, see src/lib/db.
# DATABASE_URL is the pooled connection (used by the app and scripts);
# DATABASE_URL_UNPOOLED is for migrations/one-off admin queries if needed.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
